body {
    font-family: 'Arial', sans-serif;
    background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 50%, #fecfef 100%);
    color: #333;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
}

.container {
    max-width: 800px;
    margin: 20px;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 15px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    overflow: hidden;
    animation: fadeIn 2s ease-in;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}

header {
    background: linear-gradient(45deg, #ff6b6b, #ee5a24);
    color: white;
    text-align: center;
    padding: 30px;
}

header h1 {
    margin: 0;
    font-size: 2.5em;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
}

header p {
    font-size: 1.2em;
    margin-top: 10px;
}

.hero {
    text-align: center;
    padding: 40px;
    background: linear-gradient(45deg, #ffeaa7, #fab1a0);
}

.heart {
    font-size: 4em;
    animation: heartbeat 1.5s infinite;
}

@keyframes heartbeat {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
}

.hero h2 {
    color: #d63031;
    margin: 20px 0;
}

.memories {
    padding: 40px;
    background: white;
}

.memories h2 {
    text-align: center;
    color: #e17055;
    margin-bottom: 30px;
}

.memory-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
}

.memory-card {
    perspective: 1000px;
    width: 100%;
    height: 200px;
    cursor: pointer;
}

.memory-card .front,
.memory-card .back {
    position: absolute;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    border-radius: 10px;
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    transition: transform 0.6s;
}

.memory-card .front {
    background: #f8f9fa;
    display: flex;
    justify-content: center;
    align-items: center;
}

.memory-card .back {
    background: linear-gradient(45deg, #ffeaa7, #fab1a0);
    color: #333;
    display: flex;
    justify-content: center;
    align-items: center;
    transform: rotateY(180deg);
}

.memory-card.flipped .front {
    transform: rotateY(180deg);
}

.memory-card.flipped .back {
    transform: rotateY(0deg);
}

.memory-card img {
    width: 100%;
    height: 150px;
    object-fit: cover;
    border-radius: 8px;
}

.message {
    padding: 40px;
    background: linear-gradient(45deg, #fd79a8, #fdcb6e);
    text-align: center;
    color: white;
}

.message h2 {
    margin-bottom: 20px;
}

.message p {
    font-size: 1.1em;
    line-height: 1.6;
    margin-bottom: 20px;
}

.love-button {
    background: #e84393;
    color: white;
    border: none;
    padding: 15px 30px;
    font-size: 1.2em;
    border-radius: 25px;
    cursor: pointer;
    transition: all 0.3s;
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
}

.love-button:hover {
    background: #d63031;
    transform: scale(1.05);
    box-shadow: 0 6px 20px rgba(0,0,0,0.3);
}

footer {
    background: #2d3436;
    color: white;
    text-align: center;
    padding: 20px;
}

@media (max-width: 600px) {
    header h1 {
        font-size: 2em;
    }

    .hero {
        padding: 20px;
    }

    .memories, .message {
        padding: 20px;
    }
}
